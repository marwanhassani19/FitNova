@page
@model FitNova.Pages.Nutrition.IndexModel
@{
    ViewData["Title"] = "Nutrizione";
}

<div class="page-top">
    <div>
        <div class="page-title">Nutrizione 🥗</div>
        <div class="page-subtitle">Oggi: <strong style="color:var(--green)">@((int)Model.TodayCalories) kcal</strong> — P:@((int)Model.TodayProtein)g  C:@((int)Model.TodayCarbs)g  G:@((int)Model.TodayFat)g</div>
    </div>
</div>

<div class="g2 mb24" style="align-items:start;">

    <div class="card">
        <div class="card-title">Aggiungi Alimento</div>

        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab('search',this)">🔍 Cerca</button>
            <button class="tab-btn" onclick="switchTab('barcode',this)">📷 Barcode</button>
            <button class="tab-btn" onclick="switchTab('ai',this)">🤖 AI Coach</button>
        </div>

        <div id="panel-search">
            <div class="form-group">
                <input id="searchInput" class="form-control" placeholder="Es: pasta, pollo, mela..." onkeydown="if(event.key==='Enter')searchFood()" />
            </div>
            <button class="btn btn-primary btn-full" onclick="searchFood()" style="margin-bottom:12px;">Cerca su OpenFoodFacts</button>
            <div id="searchResults" class="search-results"></div>
        </div>

        <div id="panel-barcode" style="display:none;">
            <div style="text-align:center;padding:16px 0 20px;">
                <div style="font-size:44px;margin-bottom:10px;">📷</div>
                <p style="color:var(--text-2);font-size:13px;margin-bottom:14px;">Inserisci il codice a barre del prodotto</p>
            </div>
            <div class="form-group">
                <label class="form-label">Codice Barcode</label>
                <input id="barcodeInput" class="form-control" placeholder="Es: 8001120894700" onkeydown="if(event.key==='Enter')searchBarcode()" />
            </div>
            <button class="btn btn-primary btn-full" onclick="searchBarcode()">Cerca Prodotto</button>
            <div id="barcodeResults" class="search-results" style="margin-top:10px;"></div>
        </div>

        <div id="panel-ai" style="display:none;">
            <div class="chat-container">
                <div class="chat-messages" id="chatMessages">
                    <div class="chat-msg">
                        <div class="chat-av ai">🤖</div>
                        <div class="chat-bubble ai">Ciao! Descrivi cosa hai mangiato e ti aiuto a tracciarlo. 💪</div>
                    </div>
                </div>
                <div class="chat-row">
                    <input id="chatInput" class="form-control" placeholder="Es: ho mangiato 200g di pasta al pomodoro..." onkeydown="if(event.key==='Enter')sendChat()" />
                    <button class="btn btn-primary" onclick="sendChat()" style="flex-shrink:0;">→</button>
                </div>
            </div>
        </div>

        <form method="post" asp-page-handler="AddFood" id="addForm" style="display:none;">
            <input type="hidden" name="foodName" id="hName" />
            <input type="hidden" name="calories" id="hCal" />
            <input type="hidden" name="protein" id="hPro" />
            <input type="hidden" name="carbs" id="hCarb" />
            <input type="hidden" name="fat" id="hFat" />
            <input type="hidden" name="quantity" id="hQty" value="1" />
            <input type="hidden" name="mealType" id="hMeal" value="pranzo" />
            @Html.AntiForgeryToken()
        </form>
    </div>

    <div class="card">
        <div class="card-title">Diario di Oggi</div>

        <div class="g3 mb16" style="gap:8px;">
            <div style="background:var(--bg-input);border:1px solid var(--border);border-radius:8px;padding:12px;text-align:center;">
                <div style="font-size:20px;font-weight:800;color:var(--green);">@((int)Model.TodayProtein)<span style="font-size:11px;color:var(--text-2)">g</span></div>
                <div style="font-size:10px;color:var(--text-3);text-transform:uppercase;letter-spacing:.8px;margin-top:2px;">Proteine</div>
            </div>
            <div style="background:var(--bg-input);border:1px solid var(--border);border-radius:8px;padding:12px;text-align:center;">
                <div style="font-size:20px;font-weight:800;color:var(--blue);">@((int)Model.TodayCarbs)<span style="font-size:11px;color:var(--text-2)">g</span></div>
                <div style="font-size:10px;color:var(--text-3);text-transform:uppercase;letter-spacing:.8px;margin-top:2px;">Carboidrati</div>
            </div>
            <div style="background:var(--bg-input);border:1px solid var(--border);border-radius:8px;padding:12px;text-align:center;">
                <div style="font-size:20px;font-weight:800;color:var(--orange);">@((int)Model.TodayFat)<span style="font-size:11px;color:var(--text-2)">g</span></div>
                <div style="font-size:10px;color:var(--text-3);text-transform:uppercase;letter-spacing:.8px;margin-top:2px;">Grassi</div>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Pasto</label>
            <select id="mealSelector" class="form-control" onchange="document.getElementById('hMeal').value=this.value">
                <option value="colazione">🌅 Colazione</option>
                <option value="pranzo" selected>☀️ Pranzo</option>
                <option value="cena">🌙 Cena</option>
                <option value="spuntino">🍎 Spuntino</option>
            </select>
        </div>

        @if (Model.Logs.Any())
        {
            var meals = Model.Logs.GroupBy(l => l.MealType)
            .OrderBy(g => g.Key switch { "colazione" => 0, "pranzo" => 1, "cena" => 2, _ => 3 });
            foreach (var mealGroup in meals)
            {
                var mealIcon = mealGroup.Key switch { "colazione" => "🌅", "pranzo" => "☀️", "cena" => "🌙", _ => "🍎" };
                var mealCal = mealGroup.Sum(l => (l.FoodItem?.Calories ?? 0) * l.Quantity);
                <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--text-3);margin:10px 0 4px;display:flex;justify-content:space-between;">
                    <span>@mealIcon @mealGroup.Key</span>
                    <span style="color:var(--text-2)">@((int)mealCal) kcal</span>
                </div>
                foreach (var log in mealGroup)
                {
                    <div class="food-row">
                        <div class="food-name" style="flex:1;font-size:13px;">
                            @log.FoodItem?.Name
                            <span style="color:var(--text-3);font-size:11px;margin-left:6px;">@(log.Quantity)×</span>
                        </div>
                        <span class="food-macro fm-p">@((int)((log.FoodItem?.Protein ?? 0) * log.Quantity))g</span>
                        <div class="food-kcal" style="font-size:12px;">@((int)((log.FoodItem?.Calories ?? 0) * log.Quantity))</div>
                        <form method="post" asp-page-handler="DeleteLog" style="margin:0;">
                            <input type="hidden" name="logId" value="@log.Id" />
                            @Html.AntiForgeryToken()
                            <button type="submit" style="background:none;border:none;color:var(--text-3);cursor:pointer;font-size:13px;padding:2px 4px;" title="Rimuovi">✕</button>
                        </form>
                    </div>
                }
            }
        }
        else
        {
            <div style="text-align:center;padding:28px;color:var(--text-2);font-size:13px;">
                Nessun alimento oggi.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function switchTab(name, btn) {
            ['search','barcode','ai'].forEach(t => document.getElementById('panel-'+t).style.display = t===name ? '' : 'none');
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }

        async function searchFood() {
            const q = document.getElementById('searchInput').value.trim();
            if (!q) return;
            const el = document.getElementById('searchResults');
            el.innerHTML = '<div style="color:var(--text-2);font-size:13px;padding:8px;">Cerco...</div>';
            try {
                const data = await fetch(`/Nutrition?handler=SearchFood&q=${encodeURIComponent(q)}`).then(r => r.json());
                renderItems(data.products || [], el);
            } catch {
                el.innerHTML = '<div style="color:var(--red);font-size:13px;">Errore di rete.</div>';
            }
        }

        async function searchBarcode() {
            const bc = document.getElementById('barcodeInput').value.trim();
            if (!bc) return;
            const el = document.getElementById('barcodeResults');
            el.innerHTML = '<div style="color:var(--text-2);font-size:13px;padding:8px;">Cerco...</div>';
            try {
                const data = await fetch(`/Nutrition?handler=Barcode&code=${encodeURIComponent(bc)}`).then(r => r.json());
                if (data.status === 1) renderItems([data.product], el);
                else el.innerHTML = '<div style="color:var(--red);font-size:13px;">Prodotto non trovato.</div>';
            } catch {
                el.innerHTML = '<div style="color:var(--red);font-size:13px;">Errore.</div>';
            }
        }

              function renderItems(products, container) {
            if (!products || !products.length) {
                container.innerHTML = '<div style="color:var(--text-2);font-size:13px;">Nessun risultato.</div>';
                return;
            }
            const valid = products.filter(p => p && (
                p.product_name || p.product_name_it ||
                p.product_name_en || p.abbreviated_product_name
            ));
            if (!valid.length) {
                container.innerHTML = '<div style="color:var(--text-2);font-size:13px;">Nessun risultato.</div>';
                return;
            }
            container.innerHTML = valid.slice(0, 6).map(p => {
                const n    = p.nutriments || {};
                const cal  = Math.round(
                    n['energy-kcal_100g'] ||
                    n['energy-kcal']      ||
                    (n['energy_100g'] || 0) / 4.184 || 0
                );
                const pro  = parseFloat(n.proteins_100g  || n.proteins  || 0).toFixed(1);
                const car  = parseFloat(n.carbohydrates_100g || n.carbohydrates || 0).toFixed(1);
                const fat  = parseFloat(n.fat_100g || n.fat || 0).toFixed(1);
                const name = (
                    p.product_name    ||
                    p.product_name_it ||
                    p.product_name_en ||
                    p.abbreviated_product_name ||
                    'Prodotto'
                );
                const nm = name.substring(0, 50).replace(/'/g, "\\'");
                return `<div class="search-item" onclick="addFood('${nm}',${cal},${pro},${car},${fat})">
                    <div class="search-item-name">${name}</div>
                    <div class="search-item-macros">
                        <span class="food-macro fm-p">P ${pro}g</span>
                        <span class="food-macro fm-c">C ${car}g</span>
                        <span class="food-macro fm-f">G ${fat}g</span>
                        <span style="margin-left:auto;font-size:13px;font-weight:700;color:var(--green)">${cal} kcal</span>
                    </div>
                </div>`;
            }).join('');
        }

        function addFood(name, cal, pro, car, fat) {
            document.getElementById('hName').value = name;
            document.getElementById('hCal').value  = cal;
            document.getElementById('hPro').value  = pro;
            document.getElementById('hCarb').value = car;
            document.getElementById('hFat').value  = fat;
            document.getElementById('hMeal').value = document.getElementById('mealSelector').value;
            document.getElementById('addForm').submit();
        }

        async function sendChat() {
            const inp = document.getElementById('chatInput');
            const msg = inp.value.trim();
            if (!msg) return;
            inp.value = '';
            const box = document.getElementById('chatMessages');
            box.innerHTML += `<div class="chat-msg user"><div class="chat-av user">🧑</div><div class="chat-bubble user">${msg}</div></div>`;
            const tid = 'tp_' + Date.now();
            box.innerHTML += `<div class="chat-msg" id="${tid}"><div class="chat-av ai">🤖</div><div class="chat-bubble ai typing"><span></span><span></span><span></span></div></div>`;
            box.scrollTop = box.scrollHeight;
            try {
                const res  = await fetch('/api/nutrition-chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message: msg }) });
                const data = await res.json();
                document.getElementById(tid)?.remove();
                box.innerHTML += `<div class="chat-msg"><div class="chat-av ai">🤖</div><div class="chat-bubble ai">${(data.reply || '').replace(/\n/g, '<br>')}</div></div>`;
                if (data.food) addFood(data.food.name, data.food.calories, data.food.protein, data.food.carbs, data.food.fat);
            } catch {
                document.getElementById(tid)?.remove();
                box.innerHTML += `<div class="chat-msg"><div class="chat-av ai">🤖</div><div class="chat-bubble ai" style="color:var(--red)">Errore.</div></div>`;
            }
            box.scrollTop = box.scrollHeight;
        }
    </script>
}