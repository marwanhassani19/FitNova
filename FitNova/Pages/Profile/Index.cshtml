@page
@model FitNova.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Profilo";
    Layout = "_Layout";
}

<div class="topbar">
    <div class="topbar-title">Il Mio Profilo <span style="color:var(--accent2)">👤</span></div>
</div>

<div class="grid-2" style="align-items:start;">

    <!-- FORM PROFILO -->
    <div class="card-box">
        <div class="card-label">Dati Personali</div>

        <form method="post">
            <div class="grid-2" style="gap:12px;margin-bottom:12px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Peso (kg)</label>
                    <input asp-for="Input.WeightKg" class="form-control-nova" placeholder="Es: 72" type="number" step="0.1" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Altezza (cm)</label>
                    <input asp-for="Input.HeightCm" class="form-control-nova" placeholder="Es: 178" type="number" />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Età</label>
                <input asp-for="Input.Age" class="form-control-nova" placeholder="Es: 25" type="number" />
            </div>
            <div class="form-group">
                <label class="form-label">Obiettivo</label>
                <select asp-for="Input.Goal" class="form-control-nova">
                    <option value="lose">🔥 Perdere peso</option>
                    <option value="maintain">⚖️ Mantenere il peso</option>
                    <option value="gain">💪 Aumentare massa</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Livello attività</label>
                <select asp-for="Input.ActivityLevel" class="form-control-nova">
                    <option value="sedentary">🛋️ Sedentario</option>
                    <option value="light">🚶 Leggermente attivo</option>
                    <option value="moderate">🏃 Moderatamente attivo</option>
                    <option value="active">🏋️ Molto attivo</option>
                </select>
            </div>

            <button type="submit" class="btn-nova primary" style="width:100%;justify-content:center;">
                💾 Salva Profilo
            </button>
        </form>

        @if (Model.Profile != null)
        {
            var bmi = Model.Profile.HeightCm > 0 ? Model.Profile.WeightKg / MathF.Pow(Model.Profile.HeightCm / 100f, 2) : 0;
            var bmiLabel = bmi < 18.5f ? "Sottopeso" : bmi < 25f ? "Normopeso" : bmi < 30f ? "Sovrappeso" : "Obeso";
            var bmiColor = bmi < 18.5f ? "var(--accent2)" : bmi < 25f ? "var(--accent)" : bmi < 30f ? "var(--accent3)" : "#ef4444";
            <div style="margin-top:16px;padding:14px;background:var(--bg3);border-radius:8px;border:1px solid var(--border2);">
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-size:12px;color:var(--text-muted);">BMI</span>
                    <span style="font-family:'Syne',sans-serif;font-weight:800;font-size:20px;color:@bmiColor;">@bmi.ToString("F1")</span>
                </div>
                <div style="font-size:12px;color:@bmiColor;text-align:right;font-family:'Syne',sans-serif;font-weight:600;">@bmiLabel</div>
            </div>
        }
    </div>

    <!-- PIANO NUTRIZIONISTA AI -->
    <div class="card-box">
        <div class="card-label">Piano Nutrizionista AI</div>

        @if (!string.IsNullOrEmpty(Model.AiPlan))
        {
            <div style="background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:16px;font-size:13px;line-height:1.8;color:var(--text-dim);white-space:pre-line;max-height:400px;overflow-y:auto;">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;color:var(--accent);font-family:'Syne',sans-serif;font-weight:700;">
                    🤖 Piano generato da Gemini AI
                </div>
                @Model.AiPlan
            </div>
            <form method="post" asp-page-handler="GeneratePlan" style="margin-top:12px;">
                <button type="submit" class="btn-nova secondary" style="width:100%;justify-content:center;">
                    🔄 Rigenera Piano
                </button>
            </form>
        }
        else
        {
            <div style="text-align:center;padding:32px 16px;">
                <div style="font-size:48px;margin-bottom:12px;">🤖</div>
                <p style="color:var(--text-muted);font-size:13px;margin-bottom:20px;line-height:1.6;">
                    Completa il tuo profilo e Gemini AI genererà un piano nutrizionale personalizzato per te.
                </p>
                <form method="post" asp-page-handler="GeneratePlan">
                    <button type="submit" class="btn-nova primary" style="justify-content:center;">
                        ⚡ Genera Piano AI
                    </button>
                </form>
            </div>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div style="position:fixed;bottom:24px;right:24px;background:rgba(0,255,136,0.1);border:1px solid rgba(0,255,136,0.3);border-radius:10px;padding:14px 20px;color:var(--accent);font-family:'Syne',sans-serif;font-size:13px;font-weight:600;animation:fadeUp .3s ease;z-index:1000;">
        ✓ @Model.SuccessMessage
    </div>
}
