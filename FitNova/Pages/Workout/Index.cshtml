@page
@model FitNova.Pages.Workout.IndexModel
@{
    ViewData["Title"] = "Workout";
    Layout = "_Layout";
}

<div class="topbar">
    <div class="topbar-title">Workout <span style="color:var(--accent3)">🏋️</span></div>
    <div class="topbar-user">
        <span style="font-size:12px;color:var(--text-muted)">Questa settimana: <strong style="color:var(--accent3)">@Model.WorkoutsThisWeek allenamenti</strong></span>
    </div>
</div>

<div class="grid-2" style="margin-bottom:20px;align-items:start;">

    <!-- SCHEDA AI -->
    <div class="card-box">
        <div class="card-label">Scheda Allenamento AI</div>

        @if (!string.IsNullOrEmpty(Model.WorkoutPlan))
        {
            <div style="background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:16px;font-size:13px;line-height:1.8;color:var(--text-dim);white-space:pre-line;max-height:450px;overflow-y:auto;">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;color:var(--accent3);font-family:'Syne',sans-serif;font-weight:700;">
                    🤖 Scheda generata da Gemini AI
                </div>
                @Model.WorkoutPlan
            </div>
            <div style="display:flex;gap:8px;margin-top:12px;">
                <form method="post" asp-page-handler="LogWorkout" style="flex:1;">
                    <button type="submit" class="btn-nova primary" style="width:100%;justify-content:center;background:var(--accent3);color:#000;">
                        ✓ Segna come completato
                    </button>
                </form>
                <form method="post" asp-page-handler="GeneratePlan">
                    <button type="submit" class="btn-nova secondary">🔄</button>
                </form>
            </div>
        }
        else
        {
            <div style="text-align:center;padding:32px 16px;">
                <div style="font-size:48px;margin-bottom:12px;">🏋️</div>
                <p style="color:var(--text-muted);font-size:13px;margin-bottom:20px;line-height:1.6;">
                    Genera la tua scheda personalizzata con Gemini AI basata sul tuo profilo.
                </p>
                <form method="post" asp-page-handler="GeneratePlan">
                    <button type="submit" class="btn-nova primary" style="justify-content:center;background:var(--accent3);color:#000;">
                        ⚡ Genera Scheda AI
                    </button>
                </form>
            </div>
        }
    </div>

    <!-- LOG SETTIMANA -->
    <div class="card-box">
        <div class="card-label">Log Settimana</div>

        @{
            var days = new[] { "Lun", "Mar", "Mer", "Gio", "Ven", "Sab", "Dom" };
            var today = (int)DateTime.Today.DayOfWeek;
            today = today == 0 ? 6 : today - 1; // Mon=0
        }

        <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:20px;">
            @for (int i = 0; i < 7; i++)
            {
                var done = Model.WorkoutDays.Contains(i);
                var isToday = i == today;
                <div style="text-align:center;">
                    <div style="font-size:10px;color:var(--text-muted);font-family:'Syne',sans-serif;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">@days[i]</div>
                    <div style="width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto;font-size:14px;
                        background:@(done ? "rgba(255,107,53,0.2)" : isToday ? "rgba(0,255,136,0.08)" : "var(--bg3)");
                        border:1px solid @(done ? "rgba(255,107,53,0.4)" : isToday ? "rgba(0,255,136,0.3)" : "var(--border2)")">
                        @(done ? "✓" : isToday ? "●" : "○")
                    </div>
                </div>
            }
        </div>

        <div style="margin-bottom:16px;">
            <div class="progress-label">
                <span>Obiettivo settimanale</span>
                <span>@Model.WorkoutsThisWeek / @Model.WeeklyGoal</span>
            </div>
            <div class="progress-bar-bg">
                <div class="progress-bar-fill" style="width:@(Math.Min(100, Model.WorkoutsThisWeek * 100 / Math.Max(1, Model.WeeklyGoal)))%;background:linear-gradient(90deg,var(--accent3),#ff9f35);"></div>
            </div>
        </div>

        <!-- Stats -->
        <div class="grid-2" style="gap:8px;">
            <div style="background:var(--bg3);padding:14px;border-radius:8px;text-align:center;border:1px solid var(--border2);">
                <div style="font-family:'Syne',sans-serif;font-size:24px;font-weight:800;color:var(--accent3);">@Model.TotalWorkouts</div>
                <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;">Totale</div>
            </div>
            <div style="background:var(--bg3);padding:14px;border-radius:8px;text-align:center;border:1px solid var(--border2);">
                <div style="font-family:'Syne',sans-serif;font-size:24px;font-weight:800;color:var(--accent);">@Model.Streak</div>
                <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;">Streak 🔥</div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div style="position:fixed;bottom:24px;right:24px;background:rgba(255,107,53,0.1);border:1px solid rgba(255,107,53,0.3);border-radius:10px;padding:14px 20px;color:var(--accent3);font-family:'Syne',sans-serif;font-size:13px;font-weight:600;animation:fadeUp .3s ease;z-index:1000;">
        ✓ @Model.SuccessMessage
    </div>
}
